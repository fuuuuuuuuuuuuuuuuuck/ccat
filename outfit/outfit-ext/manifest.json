{
  "manifest_version": 3,
  "name": "outfits",
  "version": "1.0.2",
  "description": "outfits dat 👀👀",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/My/Character*",
        "*://*/my/character*"
      ],
      "js": [
        "content.js",
        "update.js"
      ],
      "css": [
        "content.css",
        "update.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "outfits",
    "default_popup": "popup.html"
  }
}