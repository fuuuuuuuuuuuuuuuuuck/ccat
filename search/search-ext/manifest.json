{
  "manifest_version": 3,
  "name": "wardrobe search",
  "version": "1.0.0",
  "description": "search dat 👀👀 and qol ❤❤❤ (🙂 verity respect button)",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/My/Character*",
        "*://*/my/character*"
      ],
      "js": [
        "wardrobe.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*/My/Character*",
        "*://*/my/character*"
      ],
      "js": [
        "content.js",
        "update.js"
      ],
      "run_at": "document_idle",
      "css": [
        "update.css"
      ]
    },
    {
      "matches": [
        "*://*/My/ContentBuilder*",
        "*://*/my/contentbuilder*"
      ],
      "js": [
        "builder.js"
      ],
      "css": [
        "builder.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://ceiling.cat/*",
        "*://*.ceiling.cat/*"
      ],
      "js": [
        "glow.js"
      ],
      "css": [
        "glow.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "wardrobe search",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}